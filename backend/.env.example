# ===========================================================================
# SSAP Backend — Environment Variables Template
# Copy to .env and fill in actual values. NEVER commit .env to Git!
# ===========================================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=ssap_db

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_very_long_random_jwt_secret_here

# Admin Credentials
# Generate password hash with: node -e "const b=require('bcryptjs');b.hash('yourpassword',12).then(h=>console.log(h))"
ADMIN_EMAIL=admin@skillrock.in
ADMIN_PASSWORD_HASH=$2a$12$your_bcrypt_hash_here
ADMIN_NAME=SSAP Admin

# CORS — Frontend URL (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Email (optional — for sending notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@email.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=SSAP Team <no-reply@skillrock.in>

# Backend URL (used in production)
BACKEND_URL=https://your-backend.onrender.com
